{
  "name": "zenatiq-website",
  "private": true,
  "description": "Zenatiq Solutions website and admin portal (frontend/) with its Express API on MongoDB (backend/), deployed as one Vercel project",
  "type": "module",
  "scripts": {
    "dev": "node --watch backend/server.js",
    "demo": "node --watch backend/server.js --demo",
    "start": "node backend/server.js",
    "member": "node backend/member.js",
    "license-key": "node backend/license-key.js",
    "test": "node --test \"backend/tests/*.test.js\""
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5",
    "express": "^5.3.0",
    "mongodb": "^7.8.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
